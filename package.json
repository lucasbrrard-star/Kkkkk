{
  "name": "cidade-viva",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Cidade Viva — jogo social 3D realista em terceira pessoa (Three.js + Node/WebSocket).",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:client": "vite client --host",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build client",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "assets": "tsx tools/assets/build.ts",
    "assets:fetch": "tsx tools/assets/fetch.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.1.1",
    "@gltf-transform/extensions": "4.1.1",
    "@gltf-transform/functions": "4.1.1",
    "@types/node": "22.10.2",
    "@types/three": "0.160.0",
    "@types/ws": "8.5.13",
    "draco3dgltf": "1.5.7",
    "meshopt-sloppy": "npm:meshoptimizer@^1.0.1",
    "meshoptimizer": "0.22.0",
    "sharp": "0.33.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
