{
  "name": "cidade-viva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cidade Viva — Ilha Inicial: protótipo de RPG social isométrico em pixel art (Phaser 3 + TypeScript + Vite).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "art": "tsx art/build.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "phaser": "3.80.1"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
