{
  "name": "night-drive-neon-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NIGHT DRIVE — Neon City: jogo de corrida arcade 3D noturno no navegador (Three.js + TypeScript + Vite).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "assets": "node tools/prepare-textures.mjs && node tools/prepare-car.mjs"
  },
  "dependencies": {
    "postprocessing": "6.39.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.187.0",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
